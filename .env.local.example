# Copy this file to .env.local (and to Vercel's Environment Variables for
# production) to power the "Chat with Us" widget on the Contact page.

# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for chat replies.
# GEMINI_MODEL=gemini-flash-lite-latest

# Lead capture (name/email/phone from the "Chat with Us" form) -> Google Sheet.
# See tools/google-apps-script-lead-webhook.js for the script to deploy, and
# README.md's "Lead capture" section for the step-by-step setup.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Schedule Demo form -> a separate Google Sheet, plus an email notification
# sent by that sheet's Apps Script. See
# tools/google-apps-script-demo-webhook.js and README.md's "Schedule Demo
# notifications" section.
DEMO_SHEETS_WEBHOOK_URL=
DEMO_SHEETS_WEBHOOK_SECRET=

# Live shipping rates for the Parts Store checkout (api/shipping-rates.js).
# Leave all of these blank to keep using the built-in simulated ZIP-zone
# estimate - nothing breaks, it just won't be real carrier pricing.
# See README.md's "Shipping rates" section for how to get each one.

# USPS: free developer account at https://developers.usps.com
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=

# UPS: free developer account at https://developer.ups.com, plus a real UPS
# shipper account number (opened at ups.com) to get your own rates.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=

# Warehouse ZIP code rates are calculated from. Defaults to Ruskin, FL (33570)
# if unset.
SHIP_FROM_ZIP=33570

# Robot check (Cloudflare Turnstile) on the Schedule Demo, Parts Store and
# Chat forms. Create a widget at https://dash.cloudflare.com -> Turnstile,
# add your domain(s), then paste both keys. Leave both empty to switch the
# check off. For local testing Cloudflare provides always-pass dummy keys:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Direct email for the Get in Touch form, Parts Store requests and chat leads.
# All three land in the one inbox named in MAIL_TO (no Google Sheet needed).
# Use the mailbox that should RECEIVE them, and any mailbox that can SEND
# (often the same one). Zoho: smtp.zoho.com / 587. Gmail: smtp.gmail.com / 587
# with a Google "app password". Leave these empty and the forms fall back to
# opening the visitor's email app.
MAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: MAIL_FROM="BayBot Website <info@baybotdynamics.com>"
MAIL_FROM=

# Product admin (/site-admin). Everything the customer adds (products, photos,
# the admin login) is stored here, outside the deployed code, so a new deploy
# never overwrites it. Use an absolute path on the server, e.g.
# DATA_DIR=/home/devuser/baybot-data. Create the login with:
#   node tools/admin-user.js
DATA_DIR=
