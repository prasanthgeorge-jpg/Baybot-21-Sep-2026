# Copy this file to .env.local (and to Vercel's Environment Variables for
# production) to power the "Chat with Us" widget on the Contact page.

# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for chat replies.
# GEMINI_MODEL=gemini-flash-lite-latest

# Lead capture (name/email/phone from the "Chat with Us" form) -> Google Sheet.
# See tools/google-apps-script-lead-webhook.js for the script to deploy, and
# README.md's "Lead capture" section for the step-by-step setup.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Schedule Demo form -> a separate Google Sheet, plus an email notification
# sent by that sheet's Apps Script. See
# tools/google-apps-script-demo-webhook.js and README.md's "Schedule Demo
# notifications" section.
DEMO_SHEETS_WEBHOOK_URL=
DEMO_SHEETS_WEBHOOK_SECRET=

# Live shipping rates for the Parts Store checkout (api/shipping-rates.js).
# Leave all of these blank to keep using the built-in simulated ZIP-zone
# estimate - nothing breaks, it just won't be real carrier pricing.
# See README.md's "Shipping rates" section for how to get each one.

# USPS: free developer account at https://developers.usps.com
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=

# UPS: free developer account at https://developer.ups.com, plus a real UPS
# shipper account number (opened at ups.com) to get your own rates.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=

# Warehouse ZIP code rates are calculated from. Defaults to Ruskin, FL (33570)
# if unset.
SHIP_FROM_ZIP=33570
