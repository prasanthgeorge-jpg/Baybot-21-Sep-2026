# Nginx reverse proxy for server.js running on this same machine.
# Copy to /etc/nginx/sites-available/baybot-dynamics, edit server_name,
# symlink into sites-enabled, then run: certbot --nginx -d your-domain.com
# (certbot rewrites this file to add the HTTPS server block automatically).

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
